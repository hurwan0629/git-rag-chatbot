# Compose and the future Python backend share this root .env file.
COMPOSE_PROJECT_NAME=git-rag

# PostgreSQL connection from a backend running on this computer.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=git_rag
POSTGRES_USER=git_rag

# Required before the first database start. Use single quotes for literal $ or #.
# Example form: POSTGRES_PASSWORD='your-password'
POSTGRES_PASSWORD=

# GitHub access token. Kept out of the database container.
# The current ingestion code uses GITHUG_TOKEN, with GITHUB_TOKEN as fallback.
GITHUG_TOKEN=

# Model weights are loaded once at startup. auto selects CUDA when available.
MODEL_DEVICE=auto
SEARCH_ONLY=false
MODEL_CACHE_DIR=./data/model-cache
